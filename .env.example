# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase: copy the connection string from Project Settings > Database.
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bingnondo
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
# Customer access and refresh tokens expire at the next 12:00 AM Asia/Manila.

# ─── Email (for OTP sending) ──────────────────────────────────────────────────
# OPTION A: Gmail App Password (easiest for dev/small prod)
#   1. Google Account → Security → 2-Step Verification → App Passwords
#   2. Generate App Password for "Mail" → 16-char password
#   3. Paste below (NOT your real Gmail password)
#
# OPTION B: Any SMTP provider — just swap host/port/user/pass
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16char_app_password
EMAIL_FROM="Bingnondo Cafe <your_gmail@gmail.com>"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ─── Geocoding ────────────────────────────────────────────────────────────────
GEO_NOMINATIM_URL=https://nominatim.openstreetmap.org
GEO_USER_AGENT=BingnondoApp/1.0 (your_email@example.com)

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Internal Bridge ──────────────────────────────────────────────────────────
INTERNAL_BRIDGE_URL=http://localhost:3000/api/internal
INTERNAL_API_KEY=change_me_to_a_long_shared_secret

# ─── Firebase Cloud Messaging ─────────────────────────────────────────────────
# The API key below belongs to the Flutter client configuration. The backend
# does not use it to send pushes; it uses the Firebase service-account JSON.
FIREBASE_API_KEY=your_firebase_client_api_key_here
# In Railway, set this to the complete JSON downloaded from Firebase Console >
# Project settings > Service accounts > Generate new private key.
# Keep this private key secret. Never commit a real service-account JSON.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-firebase-project-id","private_key_id":"your-private-key-id","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-your-id@your-firebase-project-id.iam.gserviceaccount.com","client_id":"your-client-id"}
