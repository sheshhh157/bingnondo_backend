# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DB_HOST=blabla
DB_PORT=blabla
DB_NAME=blabla
DB_USER=lala
DB_PASSWORD=missyou

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (for OTP sending) ──────────────────────────────────────────────────
# OPTION A: Gmail (easiest for dev/small prod)
#   1. Go to Google Account → Security → 2-Step Verification → App Passwords
#   2. Generate an App Password for "Mail"
#   3. Use that 16-char password below (NOT your real Gmail password)
#
# OPTION B: Any SMTP provider (Brevo, Resend, Mailgun, etc.) — just swap host/port/user/pass
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16char_app_password_here
EMAIL_FROM="Bingnondo Cafe <your_gmail_address@gmail.com>"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ─── Geocoding (address pin-drop) ─────────────────────────────────────────────
# Reverse geocoding / place search uses OpenStreetMap Nominatim (free, no key).
# Their usage policy REQUIRES a descriptive User-Agent with a contact address.
# Keep this in sync with your real app name + email.
GEO_NOMINATIM_URL=wala
GEO_USER_AGENT=wala
